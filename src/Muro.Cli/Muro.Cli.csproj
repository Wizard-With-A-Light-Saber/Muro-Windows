<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>muro</AssemblyName>
    <RootNamespace>Muro.Cli</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Muro.Core\Muro.Core.csproj" />
    <ProjectReference Include="..\Muro.Platform\Muro.Platform.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\third_party\ffmpeg\ffmpeg.exe')">
    <None Include="..\..\third_party\ffmpeg\ffmpeg.exe" Link="ffmpeg\ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
