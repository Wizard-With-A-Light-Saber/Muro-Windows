<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinExe: started at sign-in or by the app it must not open a console window. Program.cs attaches
         to the parent console for the harness switches such as list-monitors. -->
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\..\assets\muro.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Muro.Engine</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Muro.Core\Muro.Core.csproj" />
    <ProjectReference Include="..\Muro.Platform\Muro.Platform.csproj" />
    <ProjectReference Include="..\Muro.Playback\Muro.Playback.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\third_party\mpv\libmpv-2.dll')">
    <None Include="..\..\third_party\mpv\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
