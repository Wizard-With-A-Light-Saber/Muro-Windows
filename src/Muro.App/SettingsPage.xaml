<Page x:Class="Muro.App.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="4,14,0,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="28,20,28,28" Spacing="8" MaxWidth="780" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="MessageBar" IsOpen="False" />

            <TextBlock Text="General" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Start with Windows" />
                            <TextBlock x:Name="StartNote" Style="{StaticResource Hint}" Text="Starts Muro quietly in the background when you sign in" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartSwitch" Grid.Column="1" Toggled="OnStartToggled" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Show the tray icon" />
                            <TextBlock Style="{StaticResource Hint}" Text="The way back into Muro and a pause button while the app is closed" />
                        </StackPanel>
                        <ToggleSwitch x:Name="TraySwitch" Grid.Column="1" Toggled="OnTrayToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Playback" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Playback speed" />
                            <TextBlock Style="{StaticResource Hint}" Text="How fast wallpapers play" />
                        </StackPanel>
                        <ComboBox x:Name="SpeedBox" Grid.Column="1" Width="130" SelectionChanged="OnSpeedChanged" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Default quality" />
                            <TextBlock Style="{StaticResource Hint}" Text="How a wallpaper plays when you apply it from Featured. Efficient caps at 30 fps for lower CPU." />
                        </StackPanel>
                        <ComboBox x:Name="QualityBox" Grid.Column="1" Width="130" SelectionChanged="OnQualityChanged" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="Pause after, and replay when the desktop is clear, are on the Schedules page." />
                </StackPanel>
            </Border>

            <TextBlock Text="Energy" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Pause when covered" />
                            <TextBlock Style="{StaticResource Hint}" Text="Freeze when a full screen app or game covers the desktop" />
                        </StackPanel>
                        <ToggleSwitch x:Name="FullscreenSwitch" Grid.Column="1" Toggled="OnEnergyToggled" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Pause in battery saver" />
                            <TextBlock Style="{StaticResource Hint}" Text="Freeze while Windows is saving energy" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SaverSwitch" Grid.Column="1" Toggled="OnEnergyToggled" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Pause on low battery" />
                            <TextBlock Style="{StaticResource Hint}" Text="Resumes by itself when the PC is plugged in" />
                        </StackPanel>
                        <ComboBox x:Name="LowBatteryBox" Grid.Column="1" Width="90" SelectionChanged="OnLowBatteryChanged" />
                        <ToggleSwitch x:Name="LowBatterySwitch" Grid.Column="2" Toggled="OnEnergyToggled" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Play only on the desktop" />
                            <TextBlock Style="{StaticResource Hint}" Text="Freeze a screen while any window is open on it" />
                        </StackPanel>
                        <ToggleSwitch x:Name="DesktopOnlySwitch" Grid.Column="1" Toggled="OnEnergyToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Displays" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel x:Name="DisplaysHost" Spacing="10" />
            </Border>

            <TextBlock Text="Storage" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="LibrarySize" Text="Library" />
                        <TextBlock x:Name="LibraryPath" Style="{StaticResource Hint}" IsTextSelectionEnabled="True" />
                        <TextBlock Style="{StaticResource Hint}" Text="The download folder can be moved from the Library page." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open folder" VerticalAlignment="Top" Click="OnOpenFolder" />
                </Grid>
            </Border>

            <TextBlock Text="About" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateText" Style="{StaticResource Hint}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckButton" Content="Check for updates" Click="OnCheck" />
                        <Button x:Name="NotesButton" Content="What's new" Click="OnNotes" Visibility="Collapsed" />
                        <Button x:Name="DownloadButton" Content="Download" Style="{StaticResource AccentButtonStyle}" Click="OnDownload" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
