<Page x:Class="Muro.App.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="CornerRadius" Value="{StaticResource MuroPanelRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="6,22,0,2" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="36,28,36,40" Spacing="8" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            <InfoBar x:Name="MessageBar" IsOpen="False" />

            <TextBlock Text="General" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Theme" />
                            <TextBlock Style="{StaticResource Hint}" Text="Light, Dark, or System to follow Windows" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="130" SelectionChanged="OnThemeChanged" />
                    </Grid>
                    <Rectangle Style="{StaticResource RowDivider}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Live wallpaper sound" />
                            <TextBlock Style="{StaticResource Hint}" Text="Videos you import from now on keep their sound. The wallpaper you set last is the one you hear. Downloaded wallpapers stay silent." />
                        </StackPanel>
                        <ToggleSwitch x:Name="SoundSwitch" Grid.Column="1" Toggled="OnSoundToggled" />
                    </Grid>
                    <Rectangle Style="{StaticResource RowDivider}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Start with Windows" />
                            <TextBlock x:Name="StartNote" Style="{StaticResource Hint}" Text="Starts Muro quietly in the background when you sign in" />
                        </StackPanel>
                        <ToggleSwitch x:Name="StartSwitch" Grid.Column="1" Toggled="OnStartToggled" />
                    </Grid>
                    <Rectangle Style="{StaticResource RowDivider}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Show the tray icon" />
                            <TextBlock Style="{StaticResource Hint}" Text="The way back into Muro and a pause button while the app is closed" />
                        </StackPanel>
                        <ToggleSwitch x:Name="TraySwitch" Grid.Column="1" Toggled="OnTrayToggled" />
                    </Grid>
                    <Rectangle Style="{StaticResource RowDivider}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Match the accent colour to the wallpaper" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="The Windows accent colour (taskbar, Start, title bars and Muro's buttons) follows the wallpaper on your main display. Switching this off brings your own colour back." />
                        </StackPanel>
                        <ToggleSwitch x:Name="AccentSwitch" Grid.Column="1" Toggled="OnAccentToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Playback" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Playback speed" />
                            <TextBlock Style="{StaticResource Hint}" Text="How fast wallpapers play" />
                        </StackPanel>
                        <ComboBox x:Name="SpeedBox" Grid.Column="1" Width="130" SelectionChanged="OnSpeedChanged" />
                    </Grid>
                    <Rectangle Style="{StaticResource RowDivider}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Default quality" />
                            <TextBlock Style="{StaticResource Hint}" Text="How a wallpaper plays when you apply it from Featured, in a playlist or on the screen saver. Automatic uses a 30 fps copy (about a third of the CPU) only for the heaviest wallpapers, 4K at 50 fps or more; Smooth and Efficient apply to all." />
                        </StackPanel>
                        <ComboBox x:Name="QualityBox" Grid.Column="1" Width="130" SelectionChanged="OnQualityChanged" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="Pause after, and replay when the desktop is clear, are on the Schedules page." />
                </StackPanel>
            </Border>

            <TextBlock Text="Effects" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="14">
                    <TextBlock Style="{StaticResource Hint}" Text="Optional extras drawn over your wallpaper. All are off by default, and each one uses a little extra CPU, GPU and memory. Muro tells you how much before you turn one on." />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Day / night sync" />
                            <TextBlock x:Name="DayNightNote" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="DayNightSwitch" Grid.Column="1" Toggled="OnEffectToggled" />
                    </Grid>
                    <Rectangle Style="{StaticResource RowDivider}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Mouse interaction" />
                            <TextBlock x:Name="CursorNote" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="CursorSwitch" Grid.Column="1" Toggled="OnEffectToggled" />
                    </Grid>
                    <Rectangle Style="{StaticResource RowDivider}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Audio reactivity" />
                            <TextBlock x:Name="AudioNote" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AudioSwitch" Grid.Column="1" Toggled="OnEffectToggled" />
                    </Grid>
                    <Rectangle Style="{StaticResource RowDivider}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Audio visualiser" />
                            <TextBlock x:Name="VisualizerNote" Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ComboBox x:Name="VisualizerBox" Grid.Column="1" Width="150" SelectionChanged="OnVisualizerStyleChanged" />
                        <ToggleSwitch x:Name="VisualizerSwitch" Grid.Column="2" Toggled="OnEffectToggled" />
                    </Grid>
                    <Rectangle Style="{StaticResource RowDivider}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Custom shader" />
                            <TextBlock x:Name="ShaderNote" Style="{StaticResource Hint}" />
                            <TextBlock x:Name="ShaderPathText" Style="{StaticResource Hint}" IsTextSelectionEnabled="True" />
                            <Button Content="Choose shader file" Margin="0,6,0,0" Click="OnShaderBrowse" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ShaderSwitch" Grid.Column="1" Toggled="OnEffectToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Energy" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Pause when covered" />
                            <TextBlock Style="{StaticResource Hint}" Text="Freeze when a full screen app or game covers the desktop" />
                        </StackPanel>
                        <ToggleSwitch x:Name="FullscreenSwitch" Grid.Column="1" Toggled="OnEnergyToggled" />
                    </Grid>
                    <Rectangle Style="{StaticResource RowDivider}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Pause in battery saver" />
                            <TextBlock Style="{StaticResource Hint}" Text="Freeze while Windows is saving energy" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SaverSwitch" Grid.Column="1" Toggled="OnEnergyToggled" />
                    </Grid>
                    <Rectangle Style="{StaticResource RowDivider}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Pause on low battery" />
                            <TextBlock Style="{StaticResource Hint}" Text="Resumes by itself when the PC is plugged in" />
                        </StackPanel>
                        <ComboBox x:Name="LowBatteryBox" Grid.Column="1" Width="90" SelectionChanged="OnLowBatteryChanged" />
                        <ToggleSwitch x:Name="LowBatterySwitch" Grid.Column="2" Toggled="OnEnergyToggled" />
                    </Grid>
                    <Rectangle Style="{StaticResource RowDivider}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Play only on the desktop" />
                            <TextBlock Style="{StaticResource Hint}" Text="Freeze a screen while any window is open on it" />
                        </StackPanel>
                        <ToggleSwitch x:Name="DesktopOnlySwitch" Grid.Column="1" Toggled="OnEnergyToggled" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Screen saver" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Use Muro as the screen saver" />
                            <TextBlock x:Name="SaverNote" Style="{StaticResource Hint}" Text="Plays a wallpaper on every display when the PC is idle" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ScreenSaverSwitch" Grid.Column="1" Toggled="OnSaverToggled" />
                    </Grid>
                    <Rectangle Style="{StaticResource RowDivider}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Start after" />
                            <TextBlock Style="{StaticResource Hint}" Text="Windows' own setting: how long the PC sits idle first" />
                        </StackPanel>
                        <ComboBox x:Name="SaverDelayBox" Grid.Column="1" Width="150" SelectionChanged="OnSaverDelayChanged" />
                    </Grid>
                    <Rectangle Style="{StaticResource RowDivider}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Plays" />
                            <TextBlock Style="{StaticResource Hint}" Text="The desktop wallpaper, one wallpaper, a playlist or an automation" />
                        </StackPanel>
                        <ComboBox x:Name="SaverPlaysBox" Grid.Column="1" Width="230" SelectionChanged="OnSaverPlaysChanged" />
                    </Grid>
                    <Button x:Name="SaverTry" Content="Try it now" Click="OnSaverTry" />
                </StackPanel>
            </Border>

            <TextBlock Text="Lock screen" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="14">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Show a Muro picture on the lock screen" />
                            <TextBlock x:Name="LockNote" Style="{StaticResource Hint}"
                                       Text="Windows cannot play video on the lock screen, so it shows one frame of the wallpaper. Your own picture comes back when this is off." />
                        </StackPanel>
                        <ToggleSwitch x:Name="LockSwitch" Grid.Column="1" Toggled="OnLockToggled" />
                    </Grid>
                    <Rectangle Style="{StaticResource RowDivider}" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Shows" />
                            <TextBlock Style="{StaticResource Hint}" Text="A playlist or automation changes the picture as it moves on" />
                        </StackPanel>
                        <ComboBox x:Name="LockPlaysBox" Grid.Column="1" Width="230" SelectionChanged="OnLockPlaysChanged" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="Displays" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel x:Name="DisplaysHost" Spacing="10" />
            </Border>

            <TextBlock Text="Storage" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="LibrarySize" Text="Library" />
                        <TextBlock x:Name="LibraryPath" Style="{StaticResource Hint}" IsTextSelectionEnabled="True" />
                        <TextBlock Style="{StaticResource Hint}" Text="The download folder can be moved from the Library page." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open folder" VerticalAlignment="Top" Click="OnOpenFolder" />
                </Grid>
            </Border>

            <TextBlock Text="About" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource Card}">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateText" Style="{StaticResource Hint}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckButton" Content="Check for updates" Click="OnCheck" />
                        <Button x:Name="NotesButton" Content="What's new" Click="OnNotes" Visibility="Collapsed" />
                        <Button x:Name="DownloadButton" Content="Download" Style="{StaticResource AccentButtonStyle}" Click="OnDownload" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
