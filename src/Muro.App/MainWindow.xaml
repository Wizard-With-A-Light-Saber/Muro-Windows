<Window x:Class="Muro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Muro">
    <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                    OpenPaneLength="200" SelectionChanged="OnNavChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Explore" Tag="explore" Icon="Globe" />
            <NavigationViewItem Content="Library" Tag="library" Icon="Library" />
            <NavigationViewItem Content="Schedules" Tag="schedules" Icon="Clock" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Window>
