<Window x:Class="Muro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Muro">
    <NavigationView x:Name="Nav" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                    OpenPaneLength="224" SelectionChanged="OnNavChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Featured" Tag="featured" Icon="Home" />
            <NavigationViewItem Content="Explore" Tag="explore" Icon="Globe" />
            <NavigationViewItem Content="Library" Tag="library" Icon="Library" />
            <NavigationViewItem Content="Schedules" Tag="schedules" Icon="Clock" />
        </NavigationView.MenuItems>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar x:Name="UpdateBar" Severity="Informational" IsOpen="False" Margin="36,12,36,0" CornerRadius="12" Closed="OnUpdateBarClosed">
                <InfoBar.ActionButton>
                    <Button Content="What's new" Click="OnUpdateNotes" />
                </InfoBar.ActionButton>
            </InfoBar>
            <Frame x:Name="ContentFrame" Grid.Row="1" />
        </Grid>
    </NavigationView>
</Window>
